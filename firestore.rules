rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.size() > 0; 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidUserProfile(data) {
      return (!('email' in data) || (data.email is string && data.email.size() <= 256))
          && (!('name' in data) || (data.name is string && data.name.size() <= 256))
          && (!('school' in data) || (data.school is string && data.school.size() <= 256))
          && (!('monthlyIncome' in data) || (data.monthlyIncome is number))
          && (!('savingGoal' in data) || (data.savingGoal is number))
          && (!('joinedDate' in data) || (data.joinedDate is string && data.joinedDate.size() <= 64));
    }

    function isValidExpense(data) {
      return (!('amount' in data) || (data.amount is number))
          && (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 128))
          && (!('title' in data) || (data.title is string && data.title.size() <= 256))
          && (!('date' in data) || (data.date is string && data.date.size() <= 64))
          && (!('isNecessary' in data) || (data.isNecessary is bool))
          && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
          && (!('note' in data) || (data.note is string && data.note.size() <= 1024));
    }

    function isValidBudget(data) {
      return (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 128))
          && (!('amount' in data) || (data.amount is number))
          && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    function isValidNotification(data) {
      return (!('type' in data) || (data.type is string && data.type.size() <= 64))
          && (!('title' in data) || (data.title is string && data.title.size() <= 256))
          && (!('message' in data) || (data.message is string && data.message.size() <= 2048))
          && (!('date' in data) || (data.date is string && data.date.size() <= 64))
          && (!('read' in data) || (data.read is bool))
          && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow list: if false; 
      allow create: if isSignedIn() 
                    && isValidId(userId) 
                    && userId == request.auth.uid 
                    && isValidUserProfile(incoming());
      allow update: if isSignedIn() 
                    && isValidId(userId) 
                    && userId == request.auth.uid 
                    && isValidUserProfile(incoming());
      allow delete: if false; 
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn() && ('userId' in resource.data) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && isValidId(expenseId) 
                    && isValidExpense(incoming())
                    && ('userId' in incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() 
                    && isValidId(expenseId) 
                    && ('userId' in existing()) && existing().userId == request.auth.uid
                    && isValidExpense(incoming())
                    && ('userId' in incoming()) && incoming().userId == existing().userId; 
      allow delete: if isSignedIn() && isValidId(expenseId) && ('userId' in existing()) && existing().userId == request.auth.uid;
    }

    match /budgets/{budgetId} {
      allow read: if isSignedIn() && ('userId' in resource.data) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && isValidId(budgetId) 
                    && isValidBudget(incoming())
                    && ('userId' in incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() 
                    && isValidId(budgetId) 
                    && ('userId' in existing()) && existing().userId == request.auth.uid
                    && isValidBudget(incoming())
                    && ('userId' in incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(budgetId) && ('userId' in existing()) && existing().userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && ('userId' in resource.data) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && isValidId(notificationId) 
                    && isValidNotification(incoming())
                    && ('userId' in incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() 
                    && isValidId(notificationId) 
                    && ('userId' in existing()) && existing().userId == request.auth.uid
                    && isValidNotification(incoming())
                    && ('userId' in incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(notificationId) && ('userId' in existing()) && existing().userId == request.auth.uid;
    }
  }
}

