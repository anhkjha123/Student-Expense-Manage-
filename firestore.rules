rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'name', 'school', 'monthlyIncome', 'savingGoal', 'joinedDate'])
          && data.email is string 
          && data.name is string 
          && data.school is string 
          && data.monthlyIncome is number
          && data.savingGoal is number
          && data.joinedDate is string;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['amount', 'categoryId', 'title', 'date', 'isNecessary', 'userId'])
          && data.amount is number 
          && data.categoryId is string 
          && data.title is string 
          && data.date is string 
          && data.isNecessary is bool
          && data.userId is string && data.userId == request.auth.uid
          && (!('note' in data) || data.note is string);
    }

    function isValidBudget(data) {
      return data.keys().hasAll(['categoryId', 'amount', 'userId'])
          && data.categoryId is string 
          && data.amount is number
          && data.userId is string && data.userId == request.auth.uid;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['type', 'title', 'message', 'date', 'read', 'userId'])
          && data.type is string 
          && data.title is string 
          && data.message is string 
          && data.date is string 
          && data.read is bool
          && data.userId is string && data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow list: if false; 
      allow create: if isSignedIn() 
                    && isValidId(userId) 
                    && userId == request.auth.uid 
                    && isValidUserProfile(incoming());
      allow update: if isSignedIn() 
                    && isValidId(userId) 
                    && userId == request.auth.uid 
                    && isValidUserProfile(incoming());
      allow delete: if false; 
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidId(expenseId) 
                    && isValidExpense(incoming());
      allow update: if isSignedIn() 
                    && isValidId(expenseId) 
                    && existing().userId == request.auth.uid
                    && isValidExpense(incoming())
                    && incoming().userId == existing().userId; 
      allow delete: if isSignedIn() && isValidId(expenseId) && existing().userId == request.auth.uid;
    }

    match /budgets/{budgetId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidId(budgetId) 
                    && isValidBudget(incoming());
      allow update: if isSignedIn() 
                    && isValidId(budgetId) 
                    && existing().userId == request.auth.uid
                    && isValidBudget(incoming())
                    && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(budgetId) && existing().userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidId(notificationId) 
                    && isValidNotification(incoming());
      allow update: if isSignedIn() 
                    && isValidId(notificationId) 
                    && existing().userId == request.auth.uid
                    && isValidNotification(incoming())
                    && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(notificationId) && existing().userId == request.auth.uid;
    }
  }
}

